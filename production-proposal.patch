+# Copyright (C) Microsoft Corporation. All rights reserved.
+# Licensed under the MIT License. See LICENSE in project root for information.
+
+import os
+import tempfile
+import unittest
+
+from pyspark.ml.classification import LogisticRegression
+
+from synapse.ml.core.init_spark import init_spark
+from synapse.ml.stages import ClassBalancer
+from synapse.ml.train import TrainClassifier, TrainedClassifierModel
+
+spark = init_spark()
+# Persistence fixtures below contain only models generated by this test.
+spark.conf.set("spark.synapseml.legacy.allowUnsafeJavaDeserialization", "true")
+
+
+class TrainClassifierColumnsSpec(unittest.TestCase):
+    def data(self, label="target"):
+        return spark.createDataFrame(
+            [
+                (0.0, -2.0, 1.0, 1.0),
+                (0.0, -1.0, 2.0, 1.0),
+                (0.0, 0.0, 3.0, 1.0),
+                (1.0, -1.0, 1.0, 8.0),
+                (1.0, 1.0, 2.0, 1.0),
+                (1.0, 2.0, 3.0, 1.0),
+            ],
+            [label, "x", "extra", "weight"],
+        )
+
+    def trainer(self):
+        learner = LogisticRegression(
+            labelCol="target", weightCol="weight", maxIter=8, regParam=0.2
+        )
+        return TrainClassifier().setModel(learner).setReindexLabel(False)
+
+    def test_inherits_python_configured_and_default_learner_labels(self):
+        configured = self.trainer()
+        self.assertFalse(configured.isDefined(configured.labelCol))
+        data = self.data()
+        model = configured.fit(data)
+        self.assertEqual(model.getLabelCol(), "target")
+        self.assertFalse(configured.isDefined(configured.labelCol))
+        self.assertEqual(model.transform(data.drop("target", "weight")).count(), 6)
+        default_data = self.data("label").drop("weight")
+        default = TrainClassifier().setModel(LogisticRegression(maxIter=8))
+        self.assertEqual(default.fit(default_data).getLabelCol(), "label")
+
+    def test_ignored_cols_copy_clear_and_estimator_persistence(self):
+        stage = self.trainer()
+        self.assertFalse(stage.isDefined(stage.ignoredCols))
+        self.assertFalse(stage.hasDefault(stage.ignoredCols))
+        stage.setIgnoredCols(["extra", "extra", "target", "weight"])
+        copied = stage.copy({})
+        self.assertEqual(copied.getIgnoredCols(), stage.getIgnoredCols())
+        with tempfile.TemporaryDirectory() as directory:
+            path = os.path.join(directory, "estimator")
+            copied.write().save(path)
+            loaded = TrainClassifier.load(path)
+            self.assertEqual(loaded.getIgnoredCols(), stage.getIgnoredCols())
+            model = loaded.fit(self.data())
+            self.assertEqual(
+                model.transform(self.data().drop("target", "weight", "extra")).count(),
+                6,
+            )
+        copied.clear(copied.ignoredCols)
+        self.assertFalse(copied.isDefined(copied.ignoredCols))
+
+    def test_fitted_persistence_and_class_balancer_end_to_end(self):
+        data = self.data().drop("weight").where("target = 0 OR x = -1")
+        balanced = ClassBalancer().setInputCol("target").fit(data).transform(data)
+        stage = self.trainer().setIgnoredCols(["extra"])
+        model = stage.fit(balanced)
+        scoring = balanced.drop("target", "weight", "extra")
+        with tempfile.TemporaryDirectory() as directory:
+            path = os.path.join(directory, "model")
+            model.write().save(path)
+            loaded = TrainedClassifierModel.load(path)
+            self.assertEqual(loaded.transform(scoring).count(), balanced.count())
+
+    def test_explicit_wrapper_label_wins_and_invalid_wrapper_does_not_fall_back(self):
+        stage = self.trainer().setLabelCol("target")
+        self.assertEqual(stage.fit(self.data()).getLabelCol(), "target")
+        with self.assertRaisesRegex(Exception, "TrainClassifier labelCol"):
+            self.trainer().setLabelCol("missing").fit(self.data())
+
+    def test_invalid_ignore_and_output_column_contracts(self):
+        for stage, message in [
+            (self.trainer().setInputCols(["x"]).setIgnoredCols([]), "cannot both"),
+            (self.trainer().setIgnoredCols(["missing"]), "ignoredCols"),
+            (self.trainer().setIgnoredCols([""]), "ignoredCols"),
+            (self.trainer().setIgnoredCols(["x", "extra"]), "at least one feature"),
+            (self.trainer().setFeaturesCol("x"), "output column"),
+        ]:
+            with self.assertRaisesRegex(Exception, message):
+                stage.fit(self.data())
+
+
+if __name__ == "__main__":
+    unittest.main()
