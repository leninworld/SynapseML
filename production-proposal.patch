+package com.microsoft.azure.synapse.ml.train
+
+import com.microsoft.azure.synapse.ml.core.test.base.TestBase
+import com.microsoft.azure.synapse.ml.stages.ClassBalancer
+import org.apache.spark.ml.{Pipeline, PipelineModel}
+import org.apache.spark.ml.classification.{LogisticRegression, LogisticRegressionModel, OneVsRest, OneVsRestModel}
+import org.apache.spark.ml.linalg.Vector
+import org.apache.spark.ml.param.ParamMap
+import org.apache.spark.sql.DataFrame
+import org.apache.spark.sql.functions.col
+
+import java.nio.file.Files
+
+private object TrainClassifierColumnsSuite {
+  val Iterations = 8
+  val Regularization = 0.2
+  val HeavyWeight = 9.0
+  val CoefficientTolerance = 1e-8
+  val WeightEffectTolerance = 1e-5
+
+}
+
+class TrainClassifierColumnsSuite extends TestBase {
+  import TrainClassifierColumnsSuite._
+
+  private def binary: DataFrame = spark.createDataFrame(Seq(
+    (0.0, -2.0, 1.0, 1.0), (0.0, -1.0, 2.0, 1.0), (0.0, 0.0, 3.0, 1.0),
+    (1.0, -1.0, 1.0, HeavyWeight), (1.0, 1.0, 2.0, 1.0), (1.0, 2.0, 3.0, 1.0)))
+    .toDF("Label", "x", "abel", "weight")
+
+  private def lr: LogisticRegression = new LogisticRegression().setMaxIter(Iterations).setRegParam(Regularization)
+
+  private def trainer: TrainClassifier = new TrainClassifier()
+    .setModel(lr.setLabelCol("Label").setWeightCol("weight"))
+    .setReindexLabel(false)
+
+  private def vectors(model: TrainedClassifierModel, data: DataFrame): Array[Vector] = {
+    model.getModel.stages.head.asInstanceOf[PipelineModel].transform(data)
+      .select(model.getFeaturesCol).collect().map(_.getAs[Vector](0))
+  }
+
+  private def coefficients(model: TrainedClassifierModel): Array[Double] =
+    model.getLastStage.asInstanceOf[LogisticRegressionModel].coefficients.toArray
+
+  private def assertClose(left: Array[Double], right: Array[Double]): Unit = {
+    assert(left.length == right.length)
+    assert(left.zip(right).forall { case (a, b) => math.abs(a - b) < CoefficientTolerance })
+  }
+
+  test("inherits configured learner label without setting the wrapper parameter") {
+    val stage = trainer
+    assert(!stage.isDefined(stage.labelCol))
+    val model = stage.fit(binary)
+    assert(!stage.isDefined(stage.labelCol))
+    assert(model.getLabelCol == "Label")
+    assert(vectors(model, binary.drop("Label", "weight")).forall(_.size == 2))
+    assert(model.transform(binary.drop("Label", "weight")).count() == binary.count())
+  }
+
+  test("inherits the learner default label") {
+    val data = binary.withColumnRenamed("Label", "label").drop("weight")
+    val model = new TrainClassifier().setModel(lr).fit(data)
+    assert(model.getLabelCol == "label")
+    assert(model.transform(data.drop("label")).count() == data.count())
+  }
+
+  test("explicit wrapper label overrides the learner") {
+    val stage = new TrainClassifier().setModel(lr.setLabelCol("missing")).setLabelCol("Label")
+    assert(stage.fit(binary.drop("weight")).getLabelCol == "Label")
+  }
+
+  Seq("", "missing").foreach { value =>
+    test(s"invalid explicit wrapper label '$value' never falls back") {
+      val error = intercept[IllegalArgumentException] { trainer.setLabelCol(value).fit(binary) }
+      assert(error.getMessage.contains("TrainClassifier labelCol"))
+    }
+  }
+
+  test("absent learner default label fails clearly") {
+    val error = intercept[IllegalArgumentException] { new TrainClassifier().setModel(lr).fit(binary) }
+    assert(error.getMessage.contains("learner default labelCol 'label'"))
+  }
+
+  test("missing configured learner label identifies its source") {
+    val error = intercept[IllegalArgumentException] {
+      new TrainClassifier().setModel(lr.setLabelCol("missing")).fit(binary)
+    }
+    assert(error.getMessage.contains("learner configured labelCol 'missing'"))
+  }
+
+  test("an empty learner weight column excludes no non-label columns") {
+    val model = new TrainClassifier().setModel(lr.setLabelCol("Label").setWeightCol(""))
+      .setReindexLabel(false).fit(binary)
+    assert(vectors(model, binary.drop("Label")).forall(_.size == 3))
+    assert(model.transform(binary.drop("Label")).count() == binary.count())
+  }
+
+  test("learner without a label parameter requires an explicit wrapper label") {
+    val error = intercept[IllegalArgumentException] {
+      new TrainClassifier().setModel(new Pipeline()).fit(binary)
+    }
+    assert(error.getMessage.contains("defined labelCol"))
+  }
+
+  test("automatic features exclude weights but retain exact substring column names") {
+    val model = trainer.fit(binary)
+    val actual = vectors(model, binary.drop("Label", "weight"))
+    assert(actual.forall(_.size == 2))
+    assert(actual.head.toArray.toSet == Set(-2.0, 1.0))
+    val processed = model.getModel.stages.head.asInstanceOf[PipelineModel].transform(binary)
+    val reference = lr.setLabelCol("Label").setWeightCol("weight")
+      .setFeaturesCol(model.getFeaturesCol).fit(processed)
+    assertClose(coefficients(model), reference.coefficients.toArray)
+    val unweighted = lr.setLabelCol("Label").setFeaturesCol(model.getFeaturesCol).fit(processed)
+    assert(coefficients(model).zip(unweighted.coefficients.toArray).exists {
+      case (a, b) => math.abs(a - b) > WeightEffectTolerance
+    })
+  }
+
+  test("explicit inputCols preserves an intentional weight feature") {
+    val model = trainer.setInputCols(Array("x", "weight")).fit(binary)
+    assert(vectors(model, binary).forall(_.size == 2))
+    intercept[Exception] { model.transform(binary.drop("weight")).collect() }
+  }
+
+  test("ignoredCols removes arbitrary columns with idempotent duplicates and redundant exclusions") {
+    val stage = trainer.setIgnoredCols(Array("abel", "abel", "Label", "weight"))
+    assert(!stage.hasDefault(stage.ignoredCols))
+    val model = stage.fit(binary)
+    assert(vectors(model, binary.drop("Label", "weight", "abel")).forall(_.size == 1))
+    assert(model.transform(binary.drop("Label", "weight", "abel")).count() == binary.count())
+  }
+
+  test("unset and explicitly empty ignoredCols select the same automatic features") {
+    val stage = trainer
+    assert(!stage.isDefined(stage.ignoredCols))
+    val implicitModel = stage.fit(binary)
+    val explicitModel = trainer.setIgnoredCols(Array.empty[String]).fit(binary)
+    assertClose(coefficients(implicitModel), coefficients(explicitModel))
+  }
+
+  Seq(Array.empty[String], Array("abel")).foreach { ignored =>
+    test(s"inputCols conflicts with defined ignoredCols of length ${ignored.length}") {
+      val error = intercept[IllegalArgumentException] {
+        trainer.setInputCols(Array("x")).setIgnoredCols(ignored).fit(binary)
+      }
+      assert(error.getMessage.contains("cannot both be set"))
+    }
+  }
+
+  Seq(Array(""), Array("missing")).foreach { ignored =>
+    test(s"invalid ignoredCols ${ignored.mkString("[", ",", "]")}") {
+      val error = intercept[IllegalArgumentException] { trainer.setIgnoredCols(ignored).fit(binary) }
+      assert(error.getMessage.contains("ignoredCols"))
+    }
+  }
+
+  test("excluding all features fails clearly") {
+    val error = intercept[IllegalArgumentException] {
+      trainer.setIgnoredCols(Array("x", "abel")).fit(binary)
+    }
+    assert(error.getMessage.contains("at least one feature"))
+  }
+
+  test("featuresCol names a unique output rather than an existing input") {
+    val error = intercept[IllegalArgumentException] { trainer.setFeaturesCol("x").fit(binary) }
+    assert(error.getMessage.contains("output column"))
+  }
+
+  test("copy and estimator persistence preserve optional ignores and inherited labels") {
+    val stage = trainer.setIgnoredCols(Array("abel"))
+    val copied = stage.copy(ParamMap.empty).asInstanceOf[TrainClassifier]
+    val path = Files.createTempDirectory("classifier-estimator").resolve("stage").toString
+    copied.write.save(path)
+    val loaded = TrainClassifier.load(path)
+    assert(!loaded.isDefined(loaded.labelCol))
+    assert(loaded.getIgnoredCols.sameElements(Array("abel")))
+    assert(loaded.fit(binary).transform(binary.drop("Label", "weight", "abel")).count() == binary.count())
+  }
+
+  test("fitted model persistence preserves scoring without training-only columns") {
+    val model = trainer.setIgnoredCols(Array("abel")).fit(binary)
+    val path = Files.createTempDirectory("classifier-model").resolve("model").toString
+    model.write.save(path)
+    val loaded = TrainedClassifierModel.load(path)
+    assertClose(coefficients(model), coefficients(loaded))
+    assert(loaded.transform(binary.drop("Label", "weight", "abel")).count() == binary.count())
+  }
+
+  test("legacy fitted-featurizer equivalent keeps its original weight feature") {
+    val legacy = trainer.setInputCols(Array("x", "weight")).fit(binary)
+    val path = Files.createTempDirectory("classifier-legacy").resolve("model").toString
+    legacy.write.save(path)
+    val loaded = TrainedClassifierModel.load(path)
+    assertClose(coefficients(legacy), coefficients(loaded))
+    assert(loaded.transform(binary).count() == binary.count())
+    intercept[Exception] { loaded.transform(binary.drop("weight")).collect() }
+  }
+
+  Seq(false, true).foreach { reindex =>
+    test(s"label equal to binary weight follows the existing learner contract with reindex=$reindex") {
+      val data = binary.drop("weight")
+      val stage = new TrainClassifier().setLabelCol("Label").setReindexLabel(reindex)
+        .setModel(lr.setLabelCol("Label").setWeightCol("Label"))
+      val model = stage.fit(data)
+      val converted = stage.convertLabel(data, "Label", None)._1
+      val processed = model.getModel.stages.head.asInstanceOf[PipelineModel].transform(converted)
+      val reference = lr.setLabelCol("Label").setWeightCol("Label")
+        .setFeaturesCol(model.getFeaturesCol).fit(processed)
+      assertClose(coefficients(model), reference.coefficients.toArray)
+    }
+  }
+
+  private def multiclass: DataFrame = spark.createDataFrame(Seq(
+    ("a", -2.0, 1.0), ("a", -1.0, 2.0), ("a", 0.0, 1.0),
+    ("b", -1.0, HeavyWeight), ("b", 1.0, 1.0), ("c", 0.0, 1.0), ("c", 2.0, 3.0)))
+    .toDF("target", "x", "weight")
+
+  test("weighted automatic OneVsRest agrees with a manual weighted reference and uses weights") {
+    val stage = new TrainClassifier().setModel(lr.setLabelCol("target").setWeightCol("weight"))
+    val model = stage.fit(multiclass)
+    val converted = stage.convertLabel(multiclass, "target", None)._1
+    val processed = model.getModel.stages.head.asInstanceOf[PipelineModel].transform(converted)
+    val reference = new OneVsRest().setClassifier(lr.setLabelCol("target").setWeightCol("weight"))
+      .setLabelCol("target").setFeaturesCol(model.getFeaturesCol).setWeightCol("weight").fit(processed)
+    val unweighted = new OneVsRest().setClassifier(lr.setLabelCol("target"))
+      .setLabelCol("target").setFeaturesCol(model.getFeaturesCol).fit(processed)
+    val actual = model.getLastStage.asInstanceOf[OneVsRestModel]
+    actual.models.zip(reference.models).foreach { case (a, b) =>
+      assertClose(a.asInstanceOf[LogisticRegressionModel].coefficients.toArray,
+        b.asInstanceOf[LogisticRegressionModel].coefficients.toArray)
+    }
+    assert(actual.models.zip(unweighted.models).exists { case (a, b) =>
+      a.asInstanceOf[LogisticRegressionModel].coefficients.toArray
+        .zip(b.asInstanceOf[LogisticRegressionModel].coefficients.toArray)
+        .exists { case (x, y) => math.abs(x - y) > WeightEffectTolerance }
+    })
+    assert(model.transform(multiclass.drop("target", "weight")).count() == multiclass.count())
+  }
+
+  test("same label and multiclass weight uses a fit-only alias without changing the learner parameter") {
+    val learner = lr.setLabelCol("target").setWeightCol("target")
+    val stage = new TrainClassifier().setModel(learner)
+    val model = stage.fit(multiclass.drop("weight"))
+    assert(learner.getWeightCol == "target")
+    val actual = model.getLastStage.asInstanceOf[OneVsRestModel]
+    assert(actual.getWeightCol != "target")
+    val converted = stage.convertLabel(multiclass.drop("weight"), "target", None)._1
+    val processed = model.getModel.stages.head.asInstanceOf[PipelineModel].transform(converted)
+      .withColumn("referenceWeight", col("target"))
+    val reference = new OneVsRest().setClassifier(lr.setWeightCol("referenceWeight"))
+      .setLabelCol("target").setFeaturesCol(model.getFeaturesCol).setWeightCol("referenceWeight").fit(processed)
+    actual.models.zip(reference.models).foreach { case (a, b) =>
+      assertClose(a.asInstanceOf[LogisticRegressionModel].coefficients.toArray,
+        b.asInstanceOf[LogisticRegressionModel].coefficients.toArray)
+    }
+    assert(model.transform(multiclass.drop("target", "weight")).count() == multiclass.count())
+  }
+
+  test("ClassBalancer weights reach the learner and are not scoring features") {
+    val data = binary.drop("weight").filter(col("Label") === 0.0 || col("x") === -1.0)
+    val weighted = new ClassBalancer().setInputCol("Label").fit(data).transform(data)
+    val model = trainer.fit(weighted)
+    assert(model.transform(weighted.drop("Label", "weight")).count() == weighted.count())
+    assert(vectors(model, weighted.drop("Label", "weight")).forall(_.size == 2))
+  }
+
+  test("missing and negative weights remain visible learner errors") {
+    intercept[Exception] { trainer.fit(binary.drop("weight")) }
+    intercept[Exception] { trainer.fit(binary.withColumn("weight", -col("weight"))) }
+  }
+}
