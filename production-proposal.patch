+package com.microsoft.azure.synapse.ml.lightgbm.split1
+
+import com.microsoft.azure.synapse.ml.lightgbm.{LightGBMClassificationModel, LightGBMClassifier}
+import com.microsoft.azure.synapse.ml.stages.ClassBalancer
+import com.microsoft.azure.synapse.ml.train.TrainClassifier
+import org.apache.spark.ml.PipelineModel
+import org.apache.spark.ml.linalg.Vector
+import org.apache.spark.sql.DataFrame
+
+private object TrainClassifierWeightsSuite {
+  val RowCount = 30
+  val HeavyWeight = 8.0
+  val ExtraFeatureModulus = 5
+  val Iterations = 5
+  val ProbabilityTolerance = 1e-8
+  val WeightEffectTolerance = 1e-6
+
+}
+
+class TrainClassifierWeightsSuite extends LightGBMTestUtils {
+  import TrainClassifierWeightsSuite._
+
+  private def data: DataFrame = spark.createDataFrame((0 until RowCount).map { index =>
+    (if (index % 3 == 0) 1.0 else 0.0, index.toDouble, (index % ExtraFeatureModulus).toDouble,
+      if (index % 3 == 0) HeavyWeight else 1.0)
+  }).toDF("Label", "x", "abel", "weight").coalesce(1)
+
+  private def learner(mode: String): LightGBMClassifier = new LightGBMClassifier()
+    .setObjective("binary").setLabelCol("Label").setNumIterations(Iterations).setNumLeaves(3)
+    .setMinDataInLeaf(1).setNumThreads(1).setNumTasks(1)
+    .setDefaultListenPort(getAndIncrementPort()).setDataTransferMode(mode)
+
+  private def probabilities(model: LightGBMClassificationModel, input: DataFrame): Array[Double] = {
+    model.transform(input).orderBy("x").select(model.getProbabilityCol).collect()
+      .map(_.getAs[Vector](0)(1))
+  }
+
+  Seq("streaming", "bulk").foreach { mode =>
+    Seq(false, true).foreach { balanced =>
+      test(s"TrainClassifier preserves native $mode weights with ClassBalancer=$balanced") {
+        val input = if (balanced) {
+          val original = data.drop("weight")
+          new ClassBalancer().setInputCol("Label").fit(original).transform(original).coalesce(1)
+        } else {
+          data
+        }
+        val base = learner(mode).setWeightCol("weight")
+        val trained = new TrainClassifier().setModel(base).setReindexLabel(false).fit(input)
+        val featurizer = trained.getModel.stages.head.asInstanceOf[PipelineModel]
+        val processed = featurizer.transform(input)
+        assert(processed.select(trained.getFeaturesCol).first().getAs[Vector](0).size == 2)
+        assert(processed.columns.contains("weight"))
+        val native = trained.getLastStage.asInstanceOf[LightGBMClassificationModel]
+        val reference = learner(mode).setWeightCol("weight")
+          .setFeaturesCol(trained.getFeaturesCol).fit(processed)
+        val unweighted = learner(mode).setFeaturesCol(trained.getFeaturesCol).fit(processed)
+        val actual = probabilities(native, processed)
+        val expected = probabilities(reference, processed)
+        assert(actual.zip(expected).forall { case (a, b) => math.abs(a - b) < ProbabilityTolerance })
+        assert(actual.zip(probabilities(unweighted, processed)).exists {
+          case (a, b) => math.abs(a - b) > WeightEffectTolerance
+        })
+        assert(trained.transform(input.drop("Label", "weight")).count() == input.count())
+      }
+    }
+  }
+}
