+  private def rawContractModel(args: String, examples: Seq[String]): VowpalWabbitClassificationModel = {
+    val native = new VowpalWabbitNative(args + " --quiet --holdout_off")
+    try {
+      (0 until 3).foreach { _ => examples.foreach(native.learnFromString) }
+      new VowpalWabbitClassificationModel().setNumClassesModel(3)
+        .setModel(native.getModel).setAdditionalFeatures(Array.empty[String])
+    } finally {
+      native.close()
+    }
+  }
+
+  private def rawContractData: DataFrame = {
+    val rows: Seq[(Long, Vector)] = Seq((0L, Vectors.dense(1.0, 0.0)),
+      (1L, Vectors.dense(0.0, 1.0)), (2L, Vectors.dense(1.0, 1.0)))
+    spark.createDataFrame(rows).toDF("id", "features").coalesce(1)
+  }
+
+  private def rawExpected(detail: Row, mode: String, base: Int, classes: Int)
+    : (Vector, Option[Vector], Double) = {
+    if (mode == "scores") {
+      val vector = Vectors.dense(detail.getAs[Seq[Float]]("predictions").map(_.toDouble).toArray)
+      (vector, Some(vector), vector.argmax.toDouble)
+    } else {
+      val value = detail.getAs[Number]("prediction").doubleValue()
+      if (mode == "winner") {
+        val raw = Vectors.sparse(classes, Array(value.toInt - base), Array(1.0))
+        (raw, None, value)
+      } else {
+        val linked = mode == "linked"
+        val p = if (linked) value else 1.0 / (1.0 + math.exp(-value))
+        val probability = Vectors.dense(1 - p, p)
+        val raw = if (linked) probability else Vectors.dense(-value, value)
+        (raw, Some(probability), probability.argmax.toDouble)
+      }
+    }
+  }
+
+  private def checkRawContract(model: VowpalWabbitClassificationModel, data: DataFrame,
+                               mode: String, base: Int): Unit = {
+    val declared = model.transformSchema(data.schema)
+    val output = model.transform(data)
+    assert(!output.columns.contains(""))
+    Seq(model.getRawPredictionCol, model.getProbabilityCol, model.getPredictionCol).filter(_.nonEmpty).foreach { name =>
+      assert(declared.fieldNames.contains(name) == output.columns.contains(name))
+      if (declared.fieldNames.contains(name)) {
+        assert(declared(name).dataType == output.schema(name).dataType)
+        assert(declared(name).metadata == output.schema(name).metadata)
+      }
+    }
+    if (mode == "winner" && model.getPredictionCol.nonEmpty) {
+      assert(output.schema(model.getPredictionCol).metadata.getMetadata("ml_attr").getLong("num_vals") ==
+        (model.getNumClassesModel + base).toLong)
+    }
+    if (model.getRawPredictionCol.nonEmpty) {
+      assert(output.schema(model.getRawPredictionCol).dataType == SQLDataTypes.VectorType)
+      assert(AttributeGroup.fromStructField(output.schema(model.getRawPredictionCol)).size == model.getNumClassesModel)
+    }
+    output.collect().foreach { row =>
+      val expected = rawExpected(row.getAs[Row](model.vowpalWabbitPredictionCol), mode, base,
+        model.getNumClassesModel)
+      if (model.getRawPredictionCol.nonEmpty) {
+        assert(row.getAs[Vector](model.getRawPredictionCol).toArray.sameElements(expected._1.toArray))
+      }
+      if (model.getProbabilityCol.nonEmpty && expected._2.isDefined) {
+        assert(row.getAs[Vector](model.getProbabilityCol).toArray.sameElements(expected._2.get.toArray))
+      }
+      if (model.getPredictionCol.nonEmpty) assert(row.getAs[Double](model.getPredictionCol) == expected._3)
+    }
+  }
+
+  private def checkRawVariants(name: String, model: VowpalWabbitClassificationModel,
+                               mode: String, base: Int): Unit = {
+    val data = rawContractData
+    checkRawContract(model, data, mode, base)
+    checkRawContract(model.copy(ParamMap.empty).setRawPredictionCol("rawCustom")
+      .setProbabilityCol("probCustom").setPredictionCol("predCustom"), data, mode, base)
+    checkRawContract(model.copy(ParamMap.empty).setRawPredictionCol(""), data, mode, base)
+    checkRawContract(model.copy(ParamMap.empty).setProbabilityCol(""), data, mode, base)
+    checkRawContract(model.copy(ParamMap.empty).setPredictionCol(""), data, mode, base)
+    val saved = new File(tmpDir.toFile, "raw-vector-" + name).toString
+    model.write.save(saved)
+    checkRawContract(VowpalWabbitClassificationModel.load(saved), data, mode, base)
+  }
+
+  test("VW raw vectors preserve binary probabilities, metadata, disabled columns and persistence") {
+    Seq("margin" -> "", "linked-space" -> "--link logistic", "linked-equals" -> "--link=logistic").foreach {
+      case (name, link) =>
+        val model = rawContractModel("--loss_function logistic " + link,
+          Seq("-1 |f x:1", "1 |f x:2")).setNumClassesModel(2)
+        if (link.nonEmpty) assert(model.vwArgs.getArgs.contains("--link logistic"))
+        checkRawVariants(name, model, if (link.isEmpty) "margin" else "linked", 0)
+    }
+  }
+
+  test("VW raw vectors preserve multiclass scores and winner labels for all indexing modes") {
+    Seq(("zero", "--indexing 0", 0), ("one", "--indexing 1", 1), ("default", "", 1)).foreach {
+      case (name, indexing, base) =>
+        val model = rawContractModel("--oaa 3 --loss_function logistic " + indexing,
+          (0 until 3).map(i => s"${i + base} |f x:${i + 1}"))
+        checkRawVariants("winner-" + name, model, "winner", base)
+        checkRawVariants("scores-" + name, model.copy(ParamMap.empty).setTestArgs("--scores"), "scores", base)
+        checkRawVariants("probabilities-" + name, model.copy(ParamMap.empty).setTestArgs("--probabilities"),
+          "scores", base)
+    }
+  }
+
+  test("VW raw winner indicators cover externally trained csoaa and ect models") {
+    Seq("csoaa" -> Seq("1:0 2:1 3:1 |f x:1", "1:1 2:0 3:1 |f x:2"),
+      "ect" -> Seq("1 |f x:1", "2 |f x:2", "3 |f x:3")).foreach { case (mode, examples) =>
+      checkRawVariants(mode, rawContractModel(s"--$mode 3", examples), "winner", 1)
+    }
+  }
+
+  test("VW raw zero binary margins retain the class-zero tie") {
+    val model = rawContractModel("--noconstant", Seq.empty[String]).setNumClassesModel(2)
+    val result = model.transform(rawContractData)
+    assert(result.schema(model.getRawPredictionCol).dataType == SQLDataTypes.VectorType)
+    val row = result.head()
+    assert(row.getAs[Vector](model.getRawPredictionCol).toArray.sameElements(Array(0.0, 0.0)))
+    assert(row.getAs[Vector](model.getProbabilityCol).toArray.sameElements(Array(0.5, 0.5)))
+    assert(row.getAs[Double](model.getPredictionCol) == 0.0)
+  }
+
+  test("VW raw rescoring preserves output-column overwrite compatibility") {
+    val model = rawContractModel("", Seq("-1 |", "1 |")).setNumClassesModel(2)
+    val previous = -99.0
+    val input = rawContractData.withColumn("prediction", lit(previous))
+      .withColumn("rawPrediction", lit(previous)).withColumn("probability", lit(previous))
+    val output = model.transform(input)
+    assert(output.select("prediction").collect().forall(_.getDouble(0) != previous))
+    assert(input.select("prediction").collect().forall(_.getDouble(0) == previous))
+  }
+
+  private def requireClassCountError(model: VowpalWabbitClassificationModel): Unit = {
+    val error = intercept[Exception] { model.transform(rawContractData).collect() }
+    assert(Iterator.iterate[Throwable](error)(_.getCause).takeWhile(_ != null)
+      .exists(cause => Option(cause.getMessage).exists(_.contains("numClasses"))))
+  }
+
+  test("VW raw vectors reject mismatched class counts without truncating native output") {
+    val model = rawContractModel("--oaa 3", Seq("3 |", "3 |", "3 |"))
+    val native = new VowpalWabbitNative("--testonly --quiet", model.getModel)
+    try {
